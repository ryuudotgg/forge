{
	"name": "@ryuugg/core",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"scripts": {
		"build": "tsdown",
		"check": "biome check",
		"clean": "git clean -xdf .turbo .cache coverage dist node_modules",
		"dev": "tsdown --watch",
		"prepare": "effect-tsgo patch",
		"test": "vitest run tests",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc"
	},
	"dependencies": {
		"effect": "catalog:effect"
	},
	"devDependencies": {
		"@effect/platform-node": "catalog:effect",
		"@effect/tsgo": "catalog:effect",
		"@effect/vitest": "catalog:effect",
		"@ryuujs/temper": "workspace:*",
		"@ryuujs/tsconfig": "workspace:*",
		"@types/node": "catalog:dev",
		"@vitest/coverage-v8": "catalog:dev",
		"tsdown": "catalog:build",
		"typescript": "catalog:dev",
		"vitest": "catalog:dev"
	}
}
