{
__EDITOR_SETTINGS__  "editor.formatOnSave": true,
__FIX_ALL_SETTING__  "files.associations": { "*.css": "tailwindcss", "*.json": "jsonc" },
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
  ],
  "tailwindCSS.classFunctions": ["cn", "cva", "cx"],
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.path": "./node_modules/typescript"
}
