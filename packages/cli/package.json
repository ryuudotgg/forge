{
	"name": "@ryuugg/forge",
	"version": "0.0.0",
	"description": "An all-in-one starter for your next big thing.",
	"keywords": [
		"forge"
	],
	"homepage": "https://github.com/ryuudotgg/forge",
	"bugs": {
		"url": "https://github.com/ryuudotgg/forge/issues",
		"email": "contact@ryuu.gg"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ryuudotgg/forge.git",
		"directory": "packages/cli"
	},
	"funding": {
		"type": "github",
		"url": "https://github.com/sponsors/ryuudotgg"
	},
	"license": "MIT",
	"author": {
		"name": "Ryuu",
		"email": "me@ryuu.gg",
		"url": "https://ryuu.gg"
	},
	"type": "module",
	"bin": "./dist/index.mjs",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"check": "biome check",
		"clean": "git clean -xdf .turbo .cache coverage dist node_modules",
		"dev": "tsdown --watch",
		"start": "node ./dist/index.mjs",
		"test": "vitest run tests",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc"
	},
	"dependencies": {
		"@clack/core": "catalog:node",
		"@clack/prompts": "catalog:node",
		"@effect/platform-node": "catalog:effect",
		"@effect/platform-node-shared": "catalog:effect",
		"@ryuugg/core": "workspace:*",
		"@ryuugg/generators": "workspace:*",
		"effect": "catalog:effect",
		"picocolors": "catalog:node"
	},
	"devDependencies": {
		"@effect/vitest": "catalog:effect",
		"@ryuugg/temper": "workspace:*",
		"@ryuugg/tsconfig": "workspace:*",
		"@types/node": "catalog:dev",
		"@vitest/coverage-v8": "catalog:dev",
		"tsdown": "catalog:build",
		"typescript": "catalog:dev",
		"vitest": "catalog:dev"
	}
}
