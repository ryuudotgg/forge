{
	"$schema": "https://turborepo.com/schema.json",
	"extends": ["//"],
	"tasks": {
		"build": {
			"outputs": []
		},
		"typecheck": {
			"dependsOn": ["build"]
		},
		"test": {
			"dependsOn": ["build", "@ryuugg/forge#build"],
			"env": [
				"FORGE_SMOKE",
				"FORGE_SMOKE_DATABASE_URL",
				"FORGE_SMOKE_MYSQL_URL"
			],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/contributing/PUBLISHING.md",
				"$TURBO_ROOT$/examples/**"
			],
			"outputs": []
		}
	}
}
