{
	"$schema": "https://turborepo.com/schema.json",
	"extends": ["//"],
	"tasks": {
		"build": {
			"outputs": []
		},
		"typecheck": {
			"dependsOn": ["build"]
		},
		"test": {
			"dependsOn": ["build", "@ryuugg/forge#build"],
			"env": ["FORGE_SMOKE", "FORGE_SMOKE_DATABASE_URL"],
			"outputs": []
		}
	}
}
